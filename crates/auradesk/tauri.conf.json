{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AuraDesk",
  "version": "0.2.2",
  "identifier": "com.ragton.auradesk",
  "build": {
    "beforeDevCommand": "pnpm --filter @auradesk/web dev",
    "beforeBuildCommand": "pnpm --filter @auradesk/web build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../../apps/web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AuraDesk",
        "width": 1200,
        "height": 800,
        "visible": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; font-src 'self' data:; media-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}