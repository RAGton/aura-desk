# direnv (Nix dev shell loader)
.direnv/

# Build artifacts
/target
**/target
**/dist
**/build
**/coverage
**/node_modules
**/.vite
**/.next
**/.turbo

# Tauri (default project layout)
/src-tauri/target
/src-tauri/gen
/src-tauri/WixTools

# Tauri (our mono-repo layout: crates/auradesk)
/crates/auradesk/gen
/crates/auradesk/target

# TypeScript incremental build info
*.tsbuildinfo

# Playwright / E2E artifacts (regenerated on every run, uploaded as CI artifacts)
apps/web/e2e-screenshots/
apps/web/test-results/
apps/web/playwright-report/

# Environment
.env
.env.local
.env.*.local

# Hindsight: config local do bank de memoria deste repo (nao versionar).
# O `bank_id` fica em .hindsight/config.toml; o resto e estado da maquina.
.hindsight/

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.idea
*.swp
*.swo
